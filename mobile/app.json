{
  "expo": {
    "name": "StreetOS AI",
    "slug": "streetos-ai",
    "version": "1.0.0",
    "orientation": "portrait",
     "scheme": "streetos",
    "userInterfaceStyle": "automatic",
     
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.streetos.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "StreetOS uses your microphone to record voice transactions.",
        "NSLocationWhenInUseUsageDescription": "StreetOS uses location to provide market intelligence for your area."
      }
    },
    "android": {
      "adaptiveIcon": {
         "backgroundColor": "#1B4332"
      },
      "package": "ai.streetos.app",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow StreetOS to access your microphone."
        }
      ],
      
      "expo-sqlite",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7eb5e018-4a6c-40cc-847b-60aab5084118"
      }
    }
  }
}
