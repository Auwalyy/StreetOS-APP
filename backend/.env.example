# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/streetos

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=<your_access_secret_min_64_chars>
JWT_REFRESH_SECRET=<your_refresh_secret_min_64_chars>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# Firebase
FIREBASE_PROJECT_ID=<project_id>
FIREBASE_PRIVATE_KEY=<private_key>
FIREBASE_CLIENT_EMAIL=<client_email>

# AI Service
AI_SERVICE_URL=http://localhost:8000

# SMS (Termii)
TERMII_API_KEY=<termii_api_key>
TERMII_SENDER_ID=StreetOS

# WhatsApp (Meta)
WHATSAPP_TOKEN=<whatsapp_token>
WHATSAPP_PHONE_ID=<phone_id>

# Twilio (fallback SMS)
TWILIO_ACCOUNT_SID=<account_sid>
TWILIO_AUTH_TOKEN=<auth_token>
TWILIO_PHONE_NUMBER=<phone_number>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Encryption
ENCRYPTION_KEY=<32_byte_hex_key>
